
# ==========================================
# TravelAgent Docker 环境配置模板
# 使用前请复制此文件为 .env.docker 并填写配置
# ==========================================
#
# 📌 本地开发 vs Docker 开发配置对比：
#
# | 配置项 | 本地开发 (不 Docker) | Docker 开发 |
# |--------|---------------------|------------|
# | MYSQL_URL | localhost:3306 | mysql:3306 |
# | QDRANT_URL | localhost:6333 | qdrant:6333 |
# | 前端访问后端 | localhost:8000 | localhost:8000 (不变) |
#
# ==========================================

# ========== MySQL 配置 ==========
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=travel_agent
MYSQL_USER=travel
MYSQL_PASSWORD=travel123456

# ========== Backend 配置 ==========
# UVICORN Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
RELOAD=true
WORKERS=1

# Database Connection
# 🔧 Docker 环境: mysql+aiomysql://travel:travel123456@mysql:3306/travel_agent?charset=utf8mb4
# 🔧 本地环境: mysql+aiomysql://root:123456@localhost:3306/travel_agent?charset=utf8mb4
MYSQL_URL=mysql+aiomysql://travel:travel123456@mysql:3306/travel_agent?charset=utf8mb4

# Qdrant 向量数据库配置
# 🔧 Docker 环境: qdrant:6333 (或 http://qdrant:6333)
# 🔧 本地环境: localhost:6333 (或 http://localhost:6333)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_URL=http://qdrant:6333  # 如果设置了，优先用这个

# JWT Configuration (请修改为随机字符串)
SECRET_KEY=your_jwt_secret_key_here_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ========== LLM Model Configuration ==========
MODEL_API_KEY=your_model_api_key_here
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen3-8B
MODEL_TEMPERATURE=0.7
MODEL_TIMEOUT=120

# EsAgent 默认配置
LLM_API_KEY=your_model_api_key_here
LLM_MODEL_ID=Qwen/Qwen3-8B
LLM_BASE_URL=https://api.siliconflow.cn/v1/
LLM_TIMEOUT=60

# ========== 各 Agent 特定配置（可选，不设置则用默认） ==========
# 聊天助手 Agent
# CHAT_AGENT_API_KEY=
# CHAT_AGENT_BASE_URL=
# CHAT_AGENT_MODEL=
# CHAT_AGENT_TEMPERATURE=
# CHAT_AGENT_TIMEOUT=

# 景点搜索 Agent
# ATTRACTION_AGENT_API_KEY=
# ATTRACTION_AGENT_BASE_URL=
# ATTRACTION_AGENT_MODEL=
# ATTRACTION_AGENT_TEMPERATURE=
# ATTRACTION_AGENT_TIMEOUT=

# 天气查询 Agent
# WEATHER_AGENT_API_KEY=
# WEATHER_AGENT_BASE_URL=
# WEATHER_AGENT_MODEL=
# WEATHER_AGENT_TEMPERATURE=
# WEATHER_AGENT_TIMEOUT=

# 酒店推荐 Agent
# HOTEL_AGENT_API_KEY=
# HOTEL_AGENT_BASE_URL=
# HOTEL_AGENT_MODEL=
# HOTEL_AGENT_TEMPERATURE=
# HOTEL_AGENT_TIMEOUT=

# 攻略专家 Agent
# GUIDE_EXPERT_AGENT_API_KEY=
# GUIDE_EXPERT_AGENT_BASE_URL=
# GUIDE_EXPERT_AGENT_MODEL=
# GUIDE_EXPERT_AGENT_TEMPERATURE=
# GUIDE_EXPERT_AGENT_TIMEOUT=

# 行程规划 Agent
# PLANNER_AGENT_API_KEY=
# PLANNER_AGENT_BASE_URL=
# PLANNER_AGENT_MODEL=
# PLANNER_AGENT_TEMPERATURE=
# PLANNER_AGENT_TIMEOUT=

# ========== 高德地图配置 ==========
AMAP_API_KEY=your_amap_api_key_here

# ========== Qdrant 配置 ==========
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ========== RAG 优化配置 ==========
RAG_USE_LLM_OPTIMIZATION=true
RAG_LLM_TEMPERATURE=0.3
RAG_QUERY_REWRITE_ENABLED=true
RAG_KEYWORD_EXTRACTION_ENABLED=true
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600

# ========== Frontend 配置 ==========
# 前端 API 地址（浏览器访问用）
VITE_API_BASE_URL=http://localhost:8000/api
# 高德地图 Web JS Key
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here

