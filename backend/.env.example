# UVICORN Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
RELOAD=true
WORKERS=1

# Database Configuration
# 🔧 本地环境: mysql+aiomysql://root:123456@localhost:3306/travel_agent?charset=utf8mb4
# 🔧 Docker 环境: mysql+aiomysql://travel:travel123456@mysql:3306/travel_agent?charset=utf8mb4
MYSQL_URL="mysql+aiomysql://root:123456@localhost:3306/travel_agent?charset=utf8mb4"

# Qdrant 向量数据库配置
# 🔧 本地环境: localhost:6333
# 🔧 Docker 环境: qdrant:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=http://localhost:6333  # 如果设置了，优先用这个

# LLM Model Configuration
MODEL_API_KEY="your_model_api_key_here"
MODEL_BASE_URL="https://api.siliconflow.cn/v1"
MODEL_NAME="Qwen/Qwen3-8B"
MODEL_TEMPERATURE=0.7
MODEL_TIMEOUT=120

# JWT Configuration
SECRET_KEY="your_jwt_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Amap Configuration (for MCP map service)
AMAP_API_KEY="your_amap_api_key_here"

# EsAgent 默认配置
# 注意：LLM_BASE_URL 结尾不要带斜杠，否则 OpenAI SDK 会拼出双斜杠导致 404
LLM_API_KEY="your_model_api_key_here"
LLM_MODEL_ID=Qwen/Qwen3-8B
LLM_BASE_URL="https://api.siliconflow.cn/v1"
LLM_TIMEOUT=60

# RAG 配置
RAG_USE_LLM_OPTIMIZATION=true
RAG_LLM_TEMPERATURE=0.3
RAG_QUERY_REWRITE_ENABLED=true
RAG_KEYWORD_EXTRACTION_ENABLED=true
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600

# TCR-RAG 配置
TCR_ENABLED=true
TCR_CANDIDATE_K=25
TCR_RERANKER_ENABLED=false
TCR_RERANKER_MODEL_PATH=models/bge-reranker-base
TCR_SCORE_WEIGHTS=0.50,0.15,0.12,0.10,0.08,0.03,0.02
TCR_SCORE_WEIGHTS_RERANK=0.55,0.20,0.10,0.06,0.04,0.03,0.02
TCR_MIN_VECTOR_SCORE=0.3
TCR_MAX_CHUNKS_PER_GUIDE=2
TCR_CONTENT_TRUNCATE_LENGTH=500
TCR_STORE_EMBED_CONTENT=false
